# Copy to .env and fill in values.

BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

DATABASE_URL="file:./dev.db"

# Seeded on `npx prisma db seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
ADMIN_NAME="Admin"

# Optional. If unset, emails are stored in the local inbox at /app/dev/inbox
RESEND_API_KEY=""
EMAIL_FROM="Chamber <noreply@localhost>"

# GunBroker REST. Deployment-wide, not a user setting.
# sandbox while developing; production on the live deploy.
GUNBROKER_ENVIRONMENT="sandbox"
GUNBROKER_SANDBOX_DEVKEY=""
GUNBROKER_PRODUCTION_DEVKEY=""
GUNBROKER_SANDBOX_USERNAME=""
GUNBROKER_SANDBOX_EMAIL=""
GUNBROKER_PRODUCTION_USERNAME=""
GUNBROKER_PRODUCTION_EMAIL=""
GUNBROKER_SANDBOX_API_URL="https://api.sandbox.gunbroker.com/v1"
GUNBROKER_PRODUCTION_API_URL="https://api.gunbroker.com/v1"
# Optional override. Default is Chamber/eepalmer/0.1.0/Inventory
# GUNBROKER_USER_AGENT="Chamber/eepalmer/0.1.0/Inventory"
