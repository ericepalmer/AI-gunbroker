# Production / DigitalOcean Droplet values.
# Copy to .env.production (gitignored) and fill in before `docker compose up`.

# Public HTTPS origin — must match the URL users open (no trailing slash).
BETTER_AUTH_URL="https://chamber.example.com"
NEXT_PUBLIC_APP_URL="https://chamber.example.com"

# openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Persistent SQLite on the Docker volume (default in compose).
DATABASE_URL="file:/data/chamber.db"

# Optional: preferred over BETTER_AUTH_SECRET for encrypting integration credentials.
# CREDENTIALS_ENCRYPTION_KEY=""

# First boot only: set SEED_ON_START=true once, then turn it off and redeploy.
SEED_ON_START="false"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# Required in production for signup / password reset (dev inbox is disabled).
RESEND_API_KEY=""
EMAIL_FROM="Chamber <noreply@yourdomain.com>"

# Live GunBroker for production deploys.
GUNBROKER_ENVIRONMENT="production"
GUNBROKER_PRODUCTION_DEVKEY=""
GUNBROKER_PRODUCTION_USERNAME=""
GUNBROKER_PRODUCTION_EMAIL=""
GUNBROKER_PRODUCTION_API_URL="https://api.gunbroker.com/v1"

# Optional sandbox keys if you keep GUNBROKER_ENVIRONMENT=sandbox on a staging box.
# GUNBROKER_SANDBOX_DEVKEY=""
# GUNBROKER_SANDBOX_USERNAME=""
# GUNBROKER_SANDBOX_EMAIL=""
# GUNBROKER_SANDBOX_API_URL="https://api.sandbox.gunbroker.com/v1"

# Used only with: docker compose --profile tls up
# Point DNS A/AAAA at the Droplet, open 80/443, set APP_PUBLISH_PORT=127.0.0.1:3000
DOMAIN="chamber.example.com"
