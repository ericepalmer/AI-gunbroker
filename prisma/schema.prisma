generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?   @default("user")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?

  sessions     Session[]
  accounts     Account[]
  integrations Integration[]
  listings     Listing[]
  wooProducts  WooProduct[]
  soldOrders   SoldOrder[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Integration {
  id               String    @id @default(cuid())
  userId           String
  provider         String
  status           String    @default("disconnected")
  environment      String    @default("sandbox")
  username         String?
  secretsCipher    String?
  externalUserId   String?
  externalUsername String?
  lastVerifiedAt   DateTime?
  lastSyncedAt     DateTime?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("integration")
}

model Listing {
  id              String    @id @default(cuid())
  userId          String
  itemId          String
  title           String
  subtitle        String?
  description     String?
  thumbnailUrl    String?
  picturesJson    String    @default("[]")
  quantity        Int       @default(1)
  price           Float?
  startingBid     Float?
  buyNowPrice     Float?
  fixedPrice      Float?
  isFixedPrice    Boolean   @default(false)
  endingAt        DateTime?
  sku             String?
  upc             String?
  reservePrice    Float?
  collectorsElite Boolean   @default(false)
  paymentMethodsJson String @default("{}")
  whoPaysForShipping Int?
  shippingProfileId Int?
  shippingClassesJson String @default("{}")
  shippingClassCostsJson String @default("{}")
  condition Int?
  isFflRequired Boolean @default(false)
  weight Float?
  weightUnit Int?
  inspectionPeriod Int?
  manufacturer String?
  caliber String?
  rounds Int?
  mfgPartNumber String?
  serialNumber String?
  gtin String?
  excludeStates String @default("")
  listingDuration Int?
  autoRelist Int?
  autoRelistFixedCount Int?
  premiumFeaturesJson String @default("{}")
  lastImportedAt  DateTime  @default(now())
  lastCommittedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@map("listing")
}

model WooProduct {
  id             String   @id @default(cuid())
  userId         String
  productId      Int
  parentId       Int      @default(0)
  name           String
  slug           String?
  permalink      String?
  sku            String?
  upc            String?
  type           String
  status         String
  stockStatus    String
  price          Float?
  regularPrice   Float?
  stockQuantity  Int?
  thumbnailUrl   String?
  description    String?
  manufacturer   String?
  caliber        String?
  rounds         Int?
  gtin           String?
  mfgPartNumber  String?
  serialNumber   String?
  attributesJson String   @default("[]")
  categoriesJson String   @default("[]")
  sourceForGunBroker Boolean @default(false)
  linkedItemId   String?
  quantitySource String   @default("woocommerce")
  manualQuantity Int?
  listedOnStore  Boolean  @default(true)
  lastImportedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([userId, linkedItemId])
  @@map("woo_product")
}

model DevEmail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  text      String
  html      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("dev_email")
}

model SoldOrder {
  id               String    @id @default(cuid())
  userId           String
  orderId          String
  orderStatus      Int       @default(0)
  orderStatusLabel String?
  itemShipped      Boolean   @default(false)
  orderComplete    Boolean   @default(false)
  buyerUsername    String?
  buyerName        String?
  orderDate        DateTime?
  totalAmount      Float?
  itemCount        Int       @default(1)
  title            String?
  thumbnailUrl     String?
  itemIdsJson      String    @default("[]")
  itemsJson        String    @default("[]")
  shipToJson       String    @default("{}")
  detailsJson      String    @default("{}")
  trackingNumber       String?
  carrier              String?
  shipStationOrderId   String?
  shipStationStatus    String?
  shipStationSyncedAt  DateTime?
  /// Buyer notified on GunBroker (complete / status 5). Independent of ShipStation shipped.
  gunBrokerNotified    Boolean   @default(false)
  workStatus           String    @default("pending")
  completedAt          DateTime?
  lastImportedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orderId])
  @@index([userId, workStatus])
  @@index([userId, orderStatus])
  @@index([userId, gunBrokerNotified])
  @@map("sold_order")
}
